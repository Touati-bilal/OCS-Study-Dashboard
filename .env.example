# ---------------------------------------------------------------------------
# PRV — Espace privé (server side)
#
# Every variable below is read on the SERVER only. None of them is ever sent to
# the browser: `lib/prv/*.server.ts` and `lib/prv/store.server.ts` enforce that
# with the `server-only` package, and `npm run test:prv` checks the client
# bundles for these values.
#
# DO NOT FILL THIS FILE IN BY HAND for the account, the password or the code.
# Run `npm run prv:setup` instead: it prompts for them with the input hidden and
# writes only hashes into `.env.local` (mode 600, already git-ignored). Editing
# these by hand means typing a secret into a file, which is exactly what the
# setup script exists to avoid.
#
# Two secrets stand in front of PRV and BOTH are required:
#   1. the owner account  — username + email + password, checked at /connexion
#   2. the 4-digit code    — checked at /prv/deverrouiller
# Neither is sufficient on its own, and neither is ever stored in plaintext.
# ---------------------------------------------------------------------------

# --- Written for you by `npm run prv:setup` ---

# Random server-side pepper. REQUIRED for the password and the code hashes below
# to be verifiable, and the reason a leaked hash cannot be cracked offline.
# The 4-digit code has only 10 000 possible values, so without a pepper its hash
# would fall in seconds. If this is missing, PRV reports itself unconfigured
# rather than falling back to something weak.
#   generate with:  node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
PRV_SECRET_PEPPER=

# Random signing key for the session cookies. At least 32 characters.
# NEVER change it while a session is open: every browser is logged out.
PRV_SESSION_SECRET=

# The owner's display name. Not a secret.
PRV_OWNER_USERNAME=

# The owner's email, used as a second identifier at sign-in. Not a secret.
PRV_OWNER_EMAIL=

# scrypt.v1 hash of the owner password, peppered. The plaintext is never stored.
# NOTE the dots, not dollars: the .env loader expands `$VAR` inside values, so a `scrypt$v1$...`
# value is destroyed before the server reads it. `npm run prv:setup` writes and re-verifies this.
PRV_OWNER_PASSWORD_HASH=

# scrypt.v1 hash of the 4-digit PRV code, peppered. The plaintext is never stored.
PRV_ACCESS_CODE_HASH=


# ---------------------------------------------------------------------------
# PRV — Optional settings
# ---------------------------------------------------------------------------

# OPTIONAL. Hash of the recovery phrase, replacing the built-in one.
# `npm run prv:setup` writes a peppered `scrypt.v1.<salt-hex>.<hash-hex>` here when you set a private
# phrase. To hash one by hand, keep the dots (the loader eats dollars):
#   node -e "const c=require('crypto');const s=c.randomBytes(16);
#     const h=c.scryptSync('YOUR PHRASE',s,64);
#     console.log('scrypt.'+s.toString('hex')+'.'+h.toString('hex'))"
# There is NO default. Leaving this empty means recovery is refused, which is the safe direction:
# a phrase only protects the account if it is a secret nobody else has read. The phrase is the way
# back in when the 4-digit code locks PRV, and it only works once the owner account is signed in -
# it is not a way around the password.
PRV_RECOVERY_HASH=

# OPTIONAL. Where the private JSON files live. Defaults to `<project>/.prv-data`.
# Must be a PERSISTENT path, and the process must be able to write to it.
# Not suitable for ephemeral or multi-instance serverless deployments.
PRV_DATA_DIR=

# OPTIONAL. Shared secret for `POST /api/prv/cron/weekly-report`, at least 16 characters.
# The cron cannot read `localStorage`, so it rebuilds the report from the latest snapshot the
# browser deposits. Without this variable the endpoint always answers 401.
PRV_CRON_SECRET=

# OPTIONAL. Set to `1` only when the app really runs behind a reverse proxy. It makes the
# sign-in and code rate limiters trust `X-Forwarded-For`; leaving it unset means a client
# cannot rotate its identity by sending that header itself.
PRV_TRUST_PROXY=


# ---------------------------------------------------------------------------
# PRV — Intelligence artificielle (optional)
#
# Any OpenAI-compatible chat-completions endpoint. The key is read on the server
# only. With no key, AI features report themselves as unconfigured and the
# deterministic report is unaffected.
# ---------------------------------------------------------------------------

AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini


# ---------------------------------------------------------------------------
# PRV — Notifications push (optional)
#
# Generate a pair with:  npx web-push generate-vapid-keys
# All three are required: without a subject there is no real contact for the push
# service, so push stays disabled rather than guessing one.
# ---------------------------------------------------------------------------

PUSH_PUBLIC_KEY=
PUSH_PRIVATE_KEY=
# Must be a real contact, e.g. `mailto:you@example.com` or `https://your-domain.example`.
PUSH_SUBJECT=


# ---------------------------------------------------------------------------
# PRV — Obsidian (optional)
#
# With these set, the Obsidian page offers real links into a local vault.
# Without them the page simply explains that the vault path is unknown.
# ---------------------------------------------------------------------------

# Absolute path of the Obsidian vault on the machine running the server.
PRV_OBSIDIAN_VAULT=
# Sub-path inside the vault that holds the study notes, e.g. `OCS/Etudes`.
# This is the name the server actually reads: `PRV_OBSIDIAN_ROOT`.
PRV_OBSIDIAN_ROOT=OCS


# ---------------------------------------------------------------------------
# Study files (not PRV)
#
# Root of the owner's uploaded documents: `module-files/` (OCS module Documents →
# Fichiers) and `<moduleId>/tp` + `<moduleId>/projects`. It is deliberately outside
# `public/`, so Next never serves these as static assets.
#
# OPTIONAL. Defaults to `<project>/uploads`. Point it somewhere else to keep a test run off
# the real documents. `PRV_UPLOADS_DIR` is still honoured as a fallback.
# ---------------------------------------------------------------------------

STUDY_UPLOADS_DIR=
